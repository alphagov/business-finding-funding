{% extends "govuk/template.njk" %}

{% from "govuk/components/back-link/macro.njk" import govukBackLink %}
{% from "govuk/components/phase-banner/macro.njk" import govukPhaseBanner %}

{% set serviceName = "Find funding for your business" %}
{% set serviceUrl = "/" %}

{% block pageTitle %}{{ pageTitle + " – " if pageTitle }}{{ serviceName }} – GOV.UK{% endblock %}

{% block head %}
  <meta name="robots" content="noindex, nofollow">
  <link rel="stylesheet" href="/assets/govuk-frontend.min.css">
{% endblock %}

{% block beforeContent %}
  {{ govukPhaseBanner({
    tag: { text: "Experiment" },
    text: "This is a test application. It is not a real service."
  }) }}

  {% if backLink %}
    {{ govukBackLink({ href: backLink }) }}
  {% endif %}
{% endblock %}

{% block bodyEnd %}
  <script type="module">
    import { initAll } from '/assets/govuk-frontend.min.js'
    initAll()
  </script>
{% endblock %}
